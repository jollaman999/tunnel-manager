[Unit]
Description=Tunnel Manager Service
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/tunnel-manager -db /var/lib/tunnel-manager/tunnel-manager.db

# The database file is the whole of this installation: the settings, the hosts
# and the account are in it, and it is the only thing the binary has to be told
# about. It is named absolutely here rather than left to the default, which is
# worked out from the user configuration directory and so depends on the HOME
# of whoever the unit runs as.
#
# Everything else this installation owns is read against the directory the
# database is in, so the key, the log and the initial password all land under
# /var/lib/tunnel-manager without being named. StateDirectory makes that
# directory and hands it to User=. A path set on the Settings screen to an
# absolute one outside it is left where it points.
StateDirectory=tunnel-manager

Restart=always
RestartSec=5
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
